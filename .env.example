# Neon PostgreSQL connection string (pooled connection recommended for the app).
# Use your Neon "development" branch URL here for local work; the production
# branch URL is configured in the deployment environment.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full"

# Context7 MCP API key (referenced as ${CONTEXT7_API_KEY} in .mcp.json).
CONTEXT7_API_KEY="ctx7sk-..."
