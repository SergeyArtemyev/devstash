# Neon PostgreSQL connection string (pooled connection recommended for the app).
# Use your Neon "development" branch URL here for local work; the production
# branch URL is configured in the deployment environment.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full"

# Context7 MCP API key (referenced as ${CONTEXT7_API_KEY} in .mcp.json).
CONTEXT7_API_KEY="ctx7sk-..."

# NextAuth v5 (Auth.js). Generate a secret with `npx auth secret`.
AUTH_SECRET=""

# GitHub OAuth app credentials. Create one at
# https://github.com/settings/developers with the callback URL
# http://localhost:3000/api/auth/callback/github for local development.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
